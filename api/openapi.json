{
  "openapi": "3.1.0",
  "info": {
    "title": "Haven & Pine Booking Demo API",
    "version": "1.0.0",
    "description": "Deterministic API for UI and API automation demonstrations. Data is held in memory and resets when the API container restarts."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "API health",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Sign in as the demo member",
        "description": "Body: { email, password }. Send the returned token as `Authorization: Bearer <token>` on /quotes and /bookings for member prices.",
        "responses": {
          "200": {
            "description": "Token and member profile"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/rooms": {
      "get": {
        "summary": "List rooms",
        "responses": {
          "200": {
            "description": "Room catalog"
          }
        }
      }
    },
    "/packages": {
      "get": {
        "summary": "List packages",
        "responses": {
          "200": {
            "description": "Package catalog"
          }
        }
      }
    },
    "/extras": {
      "get": {
        "summary": "List extras",
        "responses": {
          "200": {
            "description": "Extras catalog"
          }
        }
      }
    },
    "/quotes": {
      "post": {
        "summary": "Calculate a booking quote",
        "responses": {
          "200": {
            "description": "Calculated quote"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Member session expired"
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "summary": "Create a confirmed booking",
        "responses": {
          "201": {
            "description": "Created booking"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Member session expired"
          }
        }
      }
    },
    "/bookings/{reference}": {
      "get": {
        "summary": "Get a completed booking",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking details"
          },
          "404": {
            "description": "Booking not found"
          }
        }
      }
    }
  }
}
